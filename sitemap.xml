---
<?xml version="1.0" encoding="UTF-8"?>
<urlset
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd" xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  <url>
    <loc>https://anhhangxomfoto.github.io/</loc>
    <lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>

  {% for post in site.posts %}
  <url>
    <loc>https://anhhangxomfoto.github.io{{ post.url }}</loc>
    <lastmod>{{ post.date | date: "%Y-%m-%d" }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.2</priority>
  </url>
  {% endfor %}

  {% for page in site.html_pages %}
  <url>
    <loc>https://anhhangxomfoto.github.io/{{ page.url }}</loc>
    <lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod>
    {% if page.changefreq %}<changefreq>{{ page.changefreq }}</changefreq>{% endif %}
    {% if page.priority %}<priority>{{ page.priority }}</priority>{% endif %}
  </url>
  {% endfor %}
    {% for post in site.posts %}
  <url>
    <loc>https://anhhangxomfoto.github.io/{{ post.url | remove: 'index.html' }}</loc>
  </url>
  {% endfor %}

  {% for page in site.pages %}
  {% if page.layout != nil %}
  {% if page.layout != 'feed' %}
  <url>
      <loc>https://anhhangxomfoto.github.io/{{ page.url | remove: 'index.html' }}</loc>
  </url>
  {% endif %}
  {% endif %}
  {% endfor %}
</urlset>
